# Configuración para Pruebas E2E de MediSupply
# Copia este archivo como .env.e2e y ajusta los valores según tu entorno

# ============================================================================
# URLs de Servicios
# ============================================================================
AUTH_URL=http://localhost:3012
BFF_MOBILE_URL=http://localhost:3014
BFF_WEB_URL=http://localhost:3013

# ============================================================================
# Credenciales de Usuarios de Prueba
# ============================================================================
# Cliente (role='client')
TEST_CLIENTE_EMAIL=cliente@test.com
TEST_CLIENTE_PASSWORD=test123

# Operador/Vendedor (role='seller')
TEST_OPERADOR_EMAIL=operador@test.com
TEST_OPERADOR_PASSWORD=test123

# ============================================================================
# IDs de Datos de Prueba
# ============================================================================
# Producto (UUID v4 válido - coincide con seed_test_data.sql)
TEST_PRODUCTO_ID=9a44ac77-3fd7-483a-b8a6-ce7c2e0ba85c
TEST_PRODUCTO_NOMBRE=Producto Test E2E

# Logística
TEST_CONDUCTOR_ID=1
TEST_VEHICULO_ID=1
TEST_BODEGA=Central Bogotá

# Dirección de entrega
TEST_DIRECCION=Calle 80 #45-20, Bogotá
TEST_LATITUD=4.7110
TEST_LONGITUD=-74.0721

# ============================================================================
# Timeouts y Configuración de Pruebas
# ============================================================================
# Tiempo máximo de espera para actualización de inventario (segundos)
TIMEOUT_INVENTARIO=10

# Tiempo máximo de espera para actualización de estado de orden (segundos)
TIMEOUT_ORDER_STATUS=10

# Intervalo entre intentos de polling (segundos)
POLLING_INTERVAL=1.0

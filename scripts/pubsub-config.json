{
  "$schema": "./pubsub-config.schema.json",
  "project_id": "medisupply-474421",
  "emulator_host": "pubsub-emulator:8085",
  "topics": [
    "create-order-command",
    "order-created",
    "order-projection-created",
    "inventory-events"
  ],
  "subscriptions": [
    {
      "name": "create-order-command-sub",
      "topic": "create-order-command",
      "pushEndpoint": "order-command-handler:3000/",
      "ackDeadlineSeconds": 60
    },
    {
      "name": "order-created-sub",
      "topic": "order-created",
      "pushEndpoint": "order-query-projection:3000/",
      "ackDeadlineSeconds": 60
    },
    {
      "name": "order-projection-created-sub",
      "topic": "order-projection-created",
      "pushEndpoint": "order-query-api:3000/orders/cache-invalidation",
      "ackDeadlineSeconds": 60
    },
    {
      "name": "inventory-events-audit-sub",
      "topic": "inventory-events",
      "pushEndpoint": "auditoria-service:3000/api/auditoria/eventos/inventario",
      "ackDeadlineSeconds": 60
    }
  ],
  "healthChecks": [
    {
      "service": "order-command-handler",
      "endpoint": "order-command-handler:3000/health"
    },
    {
      "service": "order-query-projection",
      "endpoint": "order-query-projection:3000/health"
    },
    {
      "service": "order-query-api",
      "endpoint": "order-query-api:3000/health"
    }
  ]
}

